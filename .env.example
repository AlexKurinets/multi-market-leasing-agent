# Postgres with the pgvector extension
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/leasing

# Claude. The SDK also picks up credentials from `ant auth login`.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
BRIEF_EFFORT=low

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=leasing
# Hours between automated follow-ups when a prospect goes quiet
CADENCE_HOURS=[24,72,168]

# Outbound channels: "console" prints messages instead of sending them
SMS_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURES=true
PUBLIC_BASE_URL=http://localhost:8000

EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=leasing@example.com

# CRM write-back: "memory" keeps records in-process for local development
CRM_BACKEND=memory
HUBSPOT_ACCESS_TOKEN=

DASHBOARD_ORIGIN=http://localhost:3000
